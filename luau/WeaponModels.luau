function WeaponModels.build(name: string, anchored: boolean?): Model
	local def = MODELS[name]
	assert(def, "unknown weapon model " .. tostring(name))
	local fixed = anchored ~= false
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.Anchored = fixed
	root.CFrame = CFrame.identity
	root.Parent = model
	model.PrimaryPart = root
	for key, cf in def.anchors do
		local att = Instance.new("Attachment")
		att.Name = key
		att.CFrame = cf
		att.Parent = root
	end
	local holders = {}
	for i, group in def.groups do
		local holder = Instance.new("Model")
		holder.Name = group
		holder.Parent = model
		holders[i] = holder
	end
	for _, row in def.parts do
		local shape = SHAPES[row[2]]
		local part = if shape == "Wedge" then Instance.new("WedgePart") else Instance.new("Part")
		if shape == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		elseif shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		end
		part.Material = MATERIALS[row[3]]
		part.Color = Color3.fromRGB(row[4], row[5], row[6])
		part.Size = Vector3.new(row[7], row[8], row[9])
		part.CFrame = CFrame.new(row[10], row[11], row[12], row[13], row[14], row[15], row[16])
		part.Transparency = row[17]
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.Anchored = fixed
		part.Parent = holders[row[1]]
		if not fixed then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
		end
	end
	return model
end

-- anchor CFrames in the model's own frame, e.g. WeaponModels.anchor("Missile", "Exhaust")
function WeaponModels.anchor(name: string, key: string): CFrame
	local def = MODELS[name]
	return def and def.anchors[key] or CFrame.identity
end

return WeaponModels
